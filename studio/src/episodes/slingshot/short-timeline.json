   "b": 172,
   "t0": 0,
   "t1": 86,
   "line": "Nine minutes later, Earth throws you at Mars."
  },
  {
   "shot": "S3",
   "a": 172,
   "b": 276,
   "t0": 0,
   "t1": 104,
   "line": "NASA's twin ESCAPADE probes just did it. Twice."
  },
  {
   "shot": "S4",
   "a": 276,
   "b": 354,
   "t0": 0,
   "t1": 78,
   "line": "They launched in November twenty twenty-five."
  },
  {
   "shot": "S5",
   "a": 354,
   "b": 422,
   "t0": 0,
   "t1": 68,
   "line": "But Mars was on the far side of the Sun."
  },
  {
   "shot": "S6",
   "a": 422,
   "b": 486,
   "t0": 0,
   "t1": 64,
   "line": "So they parked a million miles away."
  },
  {
   "shot": "S7",
   "a": 486,
   "b": 560,
   "t0": 0,
   "t1": 74,
   "line": "Looping in a kidney-bean path for a year."
  },
  {
   "shot": "S8",
   "a": 560,
   "b": 617,
   "t0": 0,
   "t1": 57,
   "line": "Then Earth and Mars lined up."
  },
  {
   "shot": "S9",
   "a": 617,
   "b": 691,
   "t0": 0,
   "t1": 74,
   "line": "One burn. Gravity does the rest."
  },
  {
   "shot": "S10",
   "a": 691,
   "b": 740,
   "t0": 0,
   "t1": 49,
   "line": "First time NASA has done it."
  },
  {
   "shot": "S11",
   "a": 740,
   "b": 785,
   "t0": 0,
   "t1": 45,
   "line": "Ten months of coasting."
  },
  {
   "shot": "S12",
   "a": 785,
   "b": 874,
   "t0": 0,
