 "script": [
  {
   "beat": "0 cold open: comet 0-5s hook",
   "text": "Jump here and you never come back down. Watch how high your normal jump goes across space."
  },
  {
   "beat": "1 Earth: 0.5 m",
   "text": "On Earth, hop beside a gym wall: about half a metre before gravity pulls you down."
  },
  {
   "beat": "2 Moon: 3 m, ~4 s",
   "text": "On the Moon, at about one point six two metres per second squared, you soar about three metres high for nearly four seconds!"
  },
  {
   "beat": "3 Pluto: 7 m, ~9 s",
   "text": "Out on icy Pluto, at about zero point six two, you launch about seven metres up with roughly nine seconds of airtime!"
  },
  {
   "beat": "4 Comet 67P payoff: Philae 38 cm/s, ~1 km, ~2 h",
   "text": "Then try comet sixty seven P. Europe's Philae lander bounced off it at about thirty eight centimetres per second and flew about one kilometre over nearly two hours. You jump much faster, so you drift into space forever!"
  },
  {
   "beat": "5 End CTA",
   "text": "Which world next? Full film on the channel."
  }
 ],
 "science": [
  {
   "claim": "Earth standing jump ~0.5 m; Moon (1.62 m/s²) ~3 m and ~4 s; Pluto (0.62 m/s²) ~7 m and ~9 s; ESA Philae bounced off comet 67P at ~38 cm/s for ~1 km over nearly 2 hours.",
