  {
   "shot": "S59",
   "a": 4848,
   "b": 4933,
   "t0": 0,
   "t1": 85,
   "line": "That was far more than scientists expected."
  },
  {
   "shot": "S60",
   "a": 4933,
   "b": 5051,
   "t0": 0,
   "t1": 118,
   "line": "Thirty-three minutes. That is a whole episode of a sitcom."
