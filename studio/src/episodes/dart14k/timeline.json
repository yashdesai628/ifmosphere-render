   "shot": "S77",
   "a": 6453,
   "b": 6509,
   "t0": 0,
   "t1": 56,
   "line": "But everything else looks different."
  },
  {
   "shot": "S78",
   "a": 6509,
   "b": 6613,
   "t0": 0,
   "t1": 104,
   "line": "Boulders. Craters. Strange grooves and ridges."
