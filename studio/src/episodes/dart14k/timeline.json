  {
   "shot": "S65",
   "a": 5419,
   "b": 5509,
   "t0": 0,
   "t1": 90,
   "line": "Moved a rock a hundred and fifty metres wide."
  },
  {
   "shot": "S66",
   "a": 5509,
   "b": 5568,
   "t0": 0,
   "t1": 59,
   "line": "But the story does not end there."
  },
  {
   "shot": "S67",
   "a": 5568,
   "b": 5700,
   "t0": 0,
   "t1": 132,
   "line": "Four years later, a visitor arrives to survey the damage."
