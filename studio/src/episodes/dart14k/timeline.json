   "a": 6085,
   "b": 6205,
   "t0": 0,
   "t1": 120,
   "line": "It shows Didymos, the big rock, from a side no one had seen."
  },
  {
   "shot": "S74",
   "a": 6205,
   "b": 6292,
   "t0": 0,
   "t1": 87,
   "line": "DART's camera only ever saw the other face."
