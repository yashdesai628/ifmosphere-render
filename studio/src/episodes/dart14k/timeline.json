   "a": 4632,
   "b": 4704,
   "t0": 0,
   "t1": 72,
   "line": "And the answer is coming."
  },
  {
   "shot": "S57",
   "a": 4704,
   "b": 4799,
   "t0": 0,
   "t1": 95,
   "line": "The moon's orbit got shorter by thirty-three minutes."
  },
  {
   "shot": "S58",
   "a": 4799,
   "b": 4848,
   "t0": 0,
   "t1": 49,
   "line": "Give or take one minute."
